# ======================================================================
# APACHE CONFIGURATION FOR THEMAMPATTILGCC.COM
# Optimizations: SEO, AI Engine Discovery, GTmetrix A Grade, Security & CLS Fixes
# ======================================================================

RewriteEngine On

# ----------------------------------------------------------------------
# 1. DEFAULT SERVER SETTINGS & ENCODING
# ----------------------------------------------------------------------
# Force UTF-8 to prevent character rendering delays & layout jumping
AddDefaultCharset UTF-8
ServerSignature Off

# ----------------------------------------------------------------------
# 2. SSL & WWW CANONICALIZATION (PRODUCTION ONLY)
# ----------------------------------------------------------------------
# Force HTTPS and non-WWW domain canonicalization
RewriteCond %{HTTP_HOST} ^(www\.)?theyyampattilgcc\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.theyyampattilgcc\.com$ [NC]
RewriteRule ^(.*)$ https://theyyampattilgcc.com/$1 [L,R=301]

# Redirect direct index.php requests to root domain
RewriteCond %{HTTP_HOST} ^(www\.)?theyyampattilgcc\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/index\.php$
RewriteRule ^(.*)$ https://theyyampattilgcc.com/ [L,R=301]

# ----------------------------------------------------------------------
# 3. URL STRUCTURE & TRAILING SLASH LOGIC
# ----------------------------------------------------------------------
# Exclude send-mail.php from all rewrite processing to preserve POST payloads
RewriteCond %{REQUEST_URI} ^/send-mail\.php$ [NC]
RewriteRule ^ - [L]

# A. Redirect direct /example.php requests to /example/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# B. Enforce Trailing Slash: Redirect /example to /example/
# Excludes real files and real directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

# C. Internal Rewrite: Map /example/ internally to /example.php
# Works seamlessly in subdirectories (localhost) and root domain (production)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)/$ $1.php [L]

# ----------------------------------------------------------------------
# 4. GZIP / DEFLATE COMPRESSION (GTmetrix Performance)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and Fonts
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/ttf font/otf font/opentype font/woff font/woff2
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# Ensure CDNs and browsers serve correct compressed versions
<IfModule mod_headers.c>
  Header append Vary User-Agent env=!dont-vary
  Header append Vary Accept-Encoding
</IfModule>

# ----------------------------------------------------------------------
# 5. BROWSER CACHING & CLS PREVENTATIVE EXPIRES HEADERS
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Force instant layout/schema refresh for web pages (0s revalidation)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"

  # Media Assets (Instant loading & high caching)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video / Audio
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # CSS / JavaScript (Cached to prevent Cumulative Layout Shift / jumping)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Web Fonts (Prevents FOIT / Flash of Unstyled Text)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 6. CACHE-CONTROL, SECURITY & ULTRA-FAST RENDERING HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Eliminate ETag latency issues on load balanced / shared servers
  Header unset ETag
  FileETag None

  # Dynamic Pages: Prevent stale structural/schema caching
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static Assets: Immutable caching to ensure smooth scrolling & zero lag
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp|avif|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- Security Headers (Helps Google Trust & Page Security Score) ---
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Strict-Transport-Security (Forces HTTPS for 1 year)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------------------
# 7. SEARCH ENGINE & AI BOT OPTIMIZATIONS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Allow search engine crawlers & AI models (GPTBot, ClaudeBot, GoogleOther) full indexing capability
  Header set X-Robots-Tag "all, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
</IfModule>